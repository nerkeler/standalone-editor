{
  "name": "standalone-editor-frontend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.17.0 <23.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test:interaction": "node --test tests/editor-save.browser.test.js",
    "test:unit": "node --test tests/markdown-image-paths.test.js tests/markdown-source-policy.test.js tests/markdown-diagnostics.test.js tests/image-presentation.test.js tests/search-coordinator.test.js tests/markdown-size.test.js tests/request-error-message.test.js tests/safe-storage.test.js tests/workspace-recovery.test.js tests/lockfile-portability.test.js",
    "test:browser": "node --test --test-concurrency=1 --test-reporter=spec tests/editor-save.browser.test.js tests/markdown-fidelity.browser.test.js tests/markdown-rich-safe.browser.test.js tests/workspace-validation.browser.test.js tests/chrome-startup.test.js",
    "test:production-smoke": "node --test --test-concurrency=1 --test-reporter=spec tests/production-smoke.browser.test.js tests/lazy-editor-error.browser.test.js"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@tiptap/extension-code-block-lowlight": "^3.31.4",
    "@tiptap/extension-heading": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-strike": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "antd": "^5.15.0",
    "axios": "^1.20.0",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.9.0",
    "lowlight": "^3.1.0",
    "marked": "^12.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "turndown": "^7.1.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.6"
  }
}
